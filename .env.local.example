# Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public URL for Stripe redirects (local dev defaults to http://localhost:8080)
NEXT_PUBLIC_SITE_URL=

# PostHog (Project Settings → API Keys)
NEXT_PUBLIC_POSTHOG_KEY=
# Optional; default in code is https://us.i.posthog.com
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PostHog server-side analytics (admin dashboard enrichment)
# Personal API key (Project Settings → Personal API Keys), numeric project id,
# and host for the REST API. If unset, pageviews_7d is returned as null (non-blocking).
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
# Optional; default in code is https://us.posthog.com
POSTHOG_HOST=https://us.posthog.com

# Stripe (Dashboard → Developers → API keys / Webhooks → Products)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# If unset, Pro is never granted from DB alone (avoids false "Pro" locally). Set to "true" only to test Pro UI using user_profile.subscription_status without Stripe.
# TRUST_CACHED_SUBSCRIPTION_STATUS=
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs for Dad Health Pro (monthly vs annual).
# Use Stripe Price IDs (price_...). Product IDs (prod_...) can also work if product has default_price set.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
# Optional: trial days on new subscriptions (default 7)
STRIPE_TRIAL_DAYS=7

# Native Dad Health Pro verification (server-only except for store product identifiers).
# Apple root certificates: JSON array of base64-encoded DER certificates.
APPLE_IAP_PRO_MONTHLY_PRODUCT_ID=
APPLE_IAP_PRO_ANNUAL_PRODUCT_ID=
APPLE_IAP_APP_APPLE_ID=
APPLE_IAP_ROOT_CERTIFICATES_BASE64=
# Leave online certificate checks enabled in production; set false only for isolated local tests.
APPLE_IAP_ENABLE_ONLINE_CHECKS=true

# Google Play Billing / Real-time Developer Notifications.
GOOGLE_PLAY_PRO_PRODUCT_ID=
GOOGLE_PLAY_PRO_MONTHLY_BASE_PLAN_ID=
GOOGLE_PLAY_PRO_ANNUAL_BASE_PLAN_ID=
GOOGLE_PLAY_PRO_MONTHLY_TRIAL_OFFER_ID=
GOOGLE_PLAY_PRO_ANNUAL_TRIAL_OFFER_ID=
# Base64-encoded Google Play service-account JSON. Never expose this to the mobile app.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_RTDN_AUDIENCE=
GOOGLE_RTDN_SERVICE_ACCOUNT_EMAIL=

# Random server-only HMAC pepper (minimum 32 characters) for Google account linking.
SUBSCRIPTION_ACCOUNT_PEPPER=

# Server-only — used by /api/stripe/webhook to update user_profile (Supabase Dashboard → Settings → API)
SUPABASE_SERVICE_ROLE_KEY=

# Server-only HMAC pepper for per-device biometric credentials (minimum 32 random bytes).
BIOMETRIC_CREDENTIAL_PEPPER=

# Admin dashboard (/admin) — any long random string. Required for admin login + all /api/admin routes.
ADMIN_SECRET_KEY=

# OneSignal (push notifications)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# Protect cron-triggered endpoints
CRON_SECRET=
NOTIFICATION_WEBHOOK_SECRET=

# Resend (co-parent invite emails) — Dashboard → API Keys / verified domain
RESEND_API_KEY=
# Verified sender, e.g. "Dad Health <noreply@dadhealth.co.uk>"
RESEND_FROM_EMAIL=

# Secret used to sign co-parent invite links (any long random string)
CO_PARENT_INVITE_SECRET=

# After editing, restart `npm run dev` so Next.js picks up changes.
